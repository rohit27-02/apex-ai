{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "type": "object",
  "required": ["workflow", "objective", "maxAttempts"],
  "properties": {
    "workflow": {
      "type": "object",
      "required": ["entryNode", "nodes", "edges"],
      "properties": {
        "entryNode": {
          "type": "string",
          "description": "id of the node execution starts at"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "input",
                  "agent",
                  "command",
                  "validator",
                  "decision",
                  "human_gate",
                  "success",
                  "stop"
                ]
              },
              "config": {
                "type": "object",
                "description": "node-specific config, e.g. agent prompt/model, command string, validator criteria refs"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "on"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "on": {
                "type": "string",
                "enum": ["success", "failure"],
                "description": "outcome of source node this edge fires on"
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "string",
      "description": "engineering objective in natural language"
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "description": "bound on plan->execute->validate retry loop; enforced by orchestrator, not by graph shape"
    }
  }
}
